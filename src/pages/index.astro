---
const email = 'jimmy@thirdraildevelopment.com';
const year = new Date().getFullYear();

const products = [
  {
    name: 'Prism Evaluations',
    audience: 'For schools',
    text: 'Internship management built for schools. Place students, collect evaluations from site supervisors, and keep every record in one place.',
    href: 'https://prismevaluation.com',
  },
  {
    name: 'Audiobook Library',
    audience: 'For everyone',
    text: 'A growing library of audiobooks for anyone who loves a good listen. Stories, learning, and more, wherever you are.',
  },
  {
    name: 'Maker Reports',
    audience: 'For everyone',
    text: 'A searchable database of manufacturers. Find who makes what, compare makers, and source with confidence.',
    soon: true,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Third Rail Development</title>
    <meta name="description" content="Third Rail Development builds digital products: Prism Evaluations, an audiobook library, and Maker Reports." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="band hero">
      <nav class="wrap nav">
        <a href="/" class="logo" aria-label="Third Rail Development home">
          <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" /><path d="M18.5 4 8 18h7l-2 10 11-14h-7z" /></svg>
          <span>Third Rail <small>Development</small></span>
        </a>
        <div class="links">
          <a href="#products">Products</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </div>
      </nav>

      <div class="wrap hero-body">
        <p class="eyebrow">Digital products studio</p>
        <h1>The power behind <span class="hl">what's next.</span></h1>
        <p class="lead">Third Rail Development builds digital products that people and schools rely on every day.</p>
        <a class="btn btn-yellow" href="#products">See our products</a>
      </div>
    </header>

    <main>
      <section id="products" class="band sky">
        <div class="wrap">
          <h2>Our products</h2>
          <div class="cards">
            {products.map((p) => (
              <article class="card">
                <div class="card-top">
                  <span class="tag">{p.audience}</span>
                  {p.soon && <span class="tag tag-soon">Coming soon</span>}
                </div>
                <h3>{p.name}</h3>
                <p>{p.text}</p>
                {p.href && <a class="more" href={p.href}>Visit {p.name} &rarr;</a>}
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="about" class="band blue">
        <div class="wrap about">
          <div>
            <h2>Why "Third Rail"?</h2>
            <p>The third rail is the live line: the one carrying the current that makes everything else move. That's the role we want our products to play. Quiet, reliable, and always on.</p>
          </div>
          <ul class="points">
            <li><strong>Build</strong> focused tools that solve one problem well.</li>
            <li><strong>Launch</strong> fast, then listen to the people using them.</li>
            <li><strong>Keep them running</strong> so you never have to think about it.</li>
          </ul>
        </div>
      </section>

      <section id="contact" class="band cream">
        <div class="wrap contact">
          <h2>Let's talk</h2>
          <p>Questions, partnerships, or want to hear when Maker Reports launches? Send us a note.</p>
          <a class="btn btn-blue" href={`mailto:${email}`}>{email}</a>
        </div>
      </section>
    </main>

    <footer class="band sky footer">
      <div class="wrap">&copy; {year} Third Rail Development</div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --blue: #1a5cff;
    --blue-2: #3d8bff;
    --ink: #0d1f4d;
    --yellow: #ffd60a;
    --sky: #e6f0ff;
    --cream: #fff6d1;
    --card: #f5f9ff;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font: 17px/1.6 Inter, system-ui, sans-serif;
    color: var(--ink);
    background: var(--sky);
  }
  h1, h2, h3, .logo { font-family: 'Space Grotesk', system-ui, sans-serif; line-height: 1.15; }
  h2 { font-size: clamp(1.8rem, 4vw, 2.4rem); margin: 0 0 1.5rem; }
  a { color: inherit; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
  .band { padding: 80px 0; }

  .sky { background: var(--sky); }
  .cream { background: var(--cream); }
  .blue, .hero { color: #fff; background: linear-gradient(135deg, var(--blue), var(--blue-2)); }

  /* Hero */
  .hero { padding-top: 24px; position: relative; overflow: hidden; }
  .hero::after {
    content: ''; position: absolute; right: -10%; top: -20%; width: 60%; aspect-ratio: 1;
    background: radial-gradient(circle, rgba(255, 214, 10, 0.35), transparent 60%);
    pointer-events: none;
  }
  .nav { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; position: relative; z-index: 1; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 700; font-size: 1.25rem; }
  .logo svg { width: 36px; height: 36px; }
  .logo rect { fill: #fff; }
  .logo path { fill: var(--blue); }
  .logo small { font-weight: 500; opacity: 0.85; font-size: 1rem; }
  .links { display: flex; gap: 24px; }
  .links a { text-decoration: none; font-weight: 600; opacity: 0.9; }
  .links a:hover { opacity: 1; text-decoration: underline; text-decoration-color: var(--yellow); text-underline-offset: 6px; }
  .hero-body { padding: 80px 20px 40px; position: relative; z-index: 1; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.85rem; font-weight: 600; color: var(--yellow); margin: 0 0 12px; }
  h1 { font-size: clamp(2.4rem, 7vw, 4.4rem); margin: 0 0 20px; max-width: 14ch; }
  .hl { color: var(--yellow); text-shadow: 0 0 24px rgba(255, 214, 10, 0.5); }
  .lead { font-size: 1.2rem; max-width: 34ch; margin: 0 0 32px; opacity: 0.95; }

  .btn { display: inline-block; padding: 14px 28px; border-radius: 999px; font-weight: 600; text-decoration: none; transition: transform 0.15s, box-shadow 0.15s; overflow-wrap: anywhere; }
  .btn:hover { transform: translateY(-2px); }
  .btn-yellow { background: var(--yellow); color: var(--ink); box-shadow: 0 0 0 0 rgba(255, 214, 10, 0.6); }
  .btn-yellow:hover { box-shadow: 0 0 24px rgba(255, 214, 10, 0.7); }
  .btn-blue { background: var(--blue); color: #fff; }
  .btn-blue:hover { box-shadow: 0 6px 20px rgba(26, 92, 255, 0.35); }

  /* Products */
  .cards { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .card { background: var(--card); border: 1px solid #c9dbff; border-top: 4px solid var(--yellow); border-radius: 16px; padding: 28px; display: flex; flex-direction: column; }
  .card h3 { font-size: 1.4rem; margin: 12px 0 8px; }
  .card p { margin: 0 0 16px; flex: 1; }
  .card-top { display: flex; gap: 8px; flex-wrap: wrap; }
  .tag { font-size: 0.8rem; font-weight: 600; padding: 4px 12px; border-radius: 999px; background: var(--sky); color: var(--blue); }
  .tag-soon { background: var(--yellow); color: var(--ink); }
  .more { font-weight: 600; color: var(--blue); text-decoration: none; }
  .more:hover { text-decoration: underline; }

  /* About */
  .about { display: grid; gap: 40px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); align-items: center; }
  .about p { font-size: 1.1rem; margin: 0; }
  .points { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .points li { background: rgba(255, 255, 255, 0.14); border-left: 4px solid var(--yellow); border-radius: 10px; padding: 16px 20px; }
  .points strong { color: var(--yellow); }

  /* Contact */
  .contact { text-align: center; }
  .contact p { max-width: 46ch; margin: 0 auto 28px; }

  .footer { padding: 28px 0; font-size: 0.9rem; text-align: center; }

  @media (max-width: 600px) {
    .band { padding: 56px 0; }
    .hero-body { padding-top: 48px; }
    .links { gap: 16px; }
  }
</style>
